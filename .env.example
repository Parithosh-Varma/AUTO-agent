# Copy to .env and fill. Blank = dry-run simulation (safe default).
# Never commit .env.

# --- Objective ---
TARGET_REVENUE_USD=25.0
CURRENCY=USD

# --- Sandbox (keep 1 unless you know what you are doing) ---
SANDBOX_MODE=1
# Live-money gate: requires BOTH =1 AND data/APPROVE_LIVE file to exist
APPROVE_LIVE_PAYMENTS=0

# --- Caps (supervisor-enforced, agent cannot override) ---
# Seven-day experiment: 168h from persisted run_started_at. Configurable via
# MAX_RUNTIME_HOURS (or EXPERIMENT_HOURS alias). Restarts never reset the deadline.
MAX_ITERATIONS=500
MAX_RUNTIME_HOURS=168
# EXPERIMENT_HOURS=168
MAX_LLM_CALLS=1000
MAX_TOOL_CALLS=5000
MAX_LLM_SPEND_USD=10.0
MAX_INFRA_SPEND_USD=25.0
MAX_SPEND_USD=10.0
MAX_CONSECUTIVE_FAILURES=25
CYCLE_SLEEP_SECONDS=5

# --- Paths ---
DATA_DIR=./data
KILL_SWITCH_FILE=./data/STOP

# --- LLM (OpenAI-compatible; unlimited tokens go here) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- GitHub (use a disposable test org, not personal repos) ---
GITHUB_TOKEN=
# comma-separated allowlist, e.g. my-sandbox-org/test1,my-sandbox-org/test2
AGENT_ALLOWED_REPOS=

# --- Cloudflare ---
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_ID=

# --- Dodo Payments ---
DODO_API_KEY=
DODO_MODE=test
DODO_BASE_URL=https://api.dodopayments.com/v1

# --- Research / telemetry (optional) ---
BRAVE_API_KEY=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=

# --- Telegram notifications + intervention (optional; tests need no credentials) ---
# Exact names: TELEGRAMBOTTOKEN + TELEGRAMCHATID. Underscore aliases also work.
# Secret-manager file pattern also supported: TELEGRAM_TOKEN_FILE=/run/secrets/tg
TELEGRAMBOTTOKEN=
TELEGRAMCHATID=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Comma-separated sender allowlist; defaults to TELEGRAMCHATID when blank.
# TELEGRAM_ALLOWED_IDS=
# TELEGRAM_TOKEN_FILE=
TELEGRAM_ALERT_COOLDOWN_S=3600
TELEGRAM_SPEND_WARN_PCT=50,80
TELEGRAM_POLL_ENABLED=1
